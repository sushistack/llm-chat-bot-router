{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.2",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "llm-chat-bot-router@sushistack.github.com",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icons/extension-icon.png",
    "96": "icons/extension-icon.png",
    "128": "icons/extension-icon.png"
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "LLM Router",
    "default_icon": {
      "16": "icons/extension-icon.png",
      "32": "icons/extension-icon.png",
      "48": "icons/extension-icon.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://www.perplexity.ai/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_unblock",
        "enabled": true,
        "path": "rules/frame_unblock.json"
      }
    ]
  }
}
